<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="UI Test Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="org.example.listener.RetryAnnotationTransformer"/>
        <listener class-name="org.example.listener.FailedTestsListener"/>
    </listeners>

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="org.example.tests.ads.AdsSmokeTest"/>
            <class name="org.example.tests.ads.AdsQualityTest"/>
            <class name="org.example.tests.ads.AdsRegressionTest"/>
            <class name="org.example.tests.ads.AdsNegativeTest"/>

            <class name="org.example.tests.calendars.CalendarsSmokeTest"/>
            <class name="org.example.tests.calendars.CalendarsQualityTest"/>
            <class name="org.example.tests.calendars.CalendarsRegressionTest"/>
            <class name="org.example.tests.calendars.CalendarsNegativeTest"/>

            <class name="org.example.tests.modals.ModalsSmokeTest"/>
            <class name="org.example.tests.modals.ModalsQualityTest"/>
            <class name="org.example.tests.modals.ModalsRegressionTest"/>
            <class name="org.example.tests.modals.ModalsNegativeTest"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="org.example.tests.ads.AdsSmokeTest"/>
            <class name="org.example.tests.ads.AdsQualityTest"/>
            <class name="org.example.tests.ads.AdsRegressionTest"/>
            <class name="org.example.tests.ads.AdsNegativeTest"/>

            <class name="org.example.tests.calendars.CalendarsSmokeTest"/>
            <class name="org.example.tests.calendars.CalendarsQualityTest"/>
            <class name="org.example.tests.calendars.CalendarsRegressionTest"/>
            <class name="org.example.tests.calendars.CalendarsNegativeTest"/>

            <class name="org.example.tests.modals.ModalsSmokeTest"/>
            <class name="org.example.tests.modals.ModalsQualityTest"/>
            <class name="org.example.tests.modals.ModalsRegressionTest"/>
            <class name="org.example.tests.modals.ModalsNegativeTest"/>
        </classes>
    </test>

</suite>